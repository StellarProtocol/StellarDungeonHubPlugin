<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)Local.props" Condition="Exists('$(MSBuildThisFileDirectory)Local.props')" />

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS8632;CS8765</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Stellar.DungeonHub</RootNamespace>
    <AssemblyName>Stellar.DungeonHub</AssemblyName>
    <Version>1.0.0</Version>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stellar.Abstractions"       Version="2.28.0" />
    <PackageReference Include="Stellar.PluginContracts"    Version="2.28.0" />
    <PackageReference Include="Stellar.Plugin.InteropRefs" Version="2.28.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/dungeons-esc-icon.png" LogicalName="Stellar.DungeonHub.dungeons-esc-icon.png" />
    <EmbeddedResource Include="Resources/dc_enter.wav" LogicalName="Stellar.DungeonHub.dc_enter.wav" />
    <EmbeddedResource Include="Resources/dc_tick.wav" LogicalName="Stellar.DungeonHub.dc_tick.wav" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="resources/**" />
  </ItemGroup>

</Project>
